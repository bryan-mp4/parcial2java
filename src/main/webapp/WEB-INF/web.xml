<?xml version="1.0" encoding="UTF-8"?>
<!--
    Descriptor de despliegue del Sistema de Gestión y Seguimiento de Trabajos de Grado.
    Contiene solo la configuración global: filtros, tiempo de sesión, páginas de error
    y archivo de bienvenida. Los servlets se registran con @WebServlet (Servlet 4.0).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>TrabajosGrado</display-name>
    <description>Sistema de gestión y seguimiento de trabajos de grado - UTS</description>

    <!-- ================= Filtros globales ================= -->
    <!--
        El orden de los filter-mapping define el orden de ejecución:
        1) CodificacionFilter: interpreta el cuerpo de las peticiones como UTF-8.
        2) AuthFilter: comprueba que haya sesión iniciada.
        3) RolFilter: comprueba que el rol coincida con el prefijo de la URL.
    -->
    <filter>
        <filter-name>CodificacionFilter</filter-name>
        <filter-class>edu.uts.grados.filter.CodificacionFilter</filter-class>
    </filter>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>edu.uts.grados.filter.AuthFilter</filter-class>
    </filter>

    <filter>
        <filter-name>RolFilter</filter-name>
        <filter-class>edu.uts.grados.filter.RolFilter</filter-class>
    </filter>

    <!--
        AuthFilter: exige sesión iniciada en todas las rutas privadas.
        Las rutas públicas (/login, /assets/*) no se declaran aquí.
        El orden de los filter-mapping define el orden de ejecución:
        primero se comprueba que haya sesión y después el rol.
    -->
    <filter-mapping>
        <filter-name>CodificacionFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/coordinacion/*</url-pattern>
        <url-pattern>/director/*</url-pattern>
        <url-pattern>/evaluador/*</url-pattern>
        <url-pattern>/estudiante/*</url-pattern>
        <url-pattern>/inicio</url-pattern>
        <url-pattern>/calendario/*</url-pattern>
        <url-pattern>/formatos/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- RolFilter: cada prefijo de URL es exclusivo de su rol. -->
    <filter-mapping>
        <filter-name>RolFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/coordinacion/*</url-pattern>
        <url-pattern>/director/*</url-pattern>
        <url-pattern>/evaluador/*</url-pattern>
        <url-pattern>/estudiante/*</url-pattern>
        <url-pattern>/inicio</url-pattern>
        <url-pattern>/calendario/*</url-pattern>
        <url-pattern>/formatos/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- ================= Sesión ================= -->
    <!-- 30 minutos de inactividad. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- En producción, con HTTPS, cambiar a true. -->
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ================= Páginas de error ================= -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/comun/error403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/comun/error404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/comun/error500.jsp</location>
    </error-page>

    <!-- ================= Bienvenida ================= -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
</web-app>
